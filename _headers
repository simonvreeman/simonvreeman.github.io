# This is a comment
/*
    Content-Security-Policy: upgrade-insecure-requests
    Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
    X-DNS-Prefetch-Control: on
    tdm-reservation: 0
    X-John-Deere: 6320
    # rel="describedby" is llms.txt v2's one hard addition — without it the file is found only by an
    # agent that already guessed the root path, which is the failure v2 set out to fix.
    # rel="agent-skills" is a deliberate divergence: specification.website recommends this exact
    # spelling, but the Cloudflare discovery RFC defines no link relation at all (it is well-known-URI
    # only) and "agent-skills" is not in the IANA registry, so RFC 8288 2.1.2 would want a URI here.
    # Kept as the bare token anyway: the token is what any client following that advice looks for,
    # and a conformant URI nothing searches for would be worse. Revisit if it is ever registered.
    Link: <https://gtm.vreeman.com>; rel="preconnect"; crossorigin, <https://gtm.vreeman.com>; rel="dns-prefetch", <https://vreeman.com/schema.json>; rel="alternate"; type="application/ld+json", </llms.txt>; rel="describedby"; type="text/markdown", </.well-known/agent-skills/index.json>; rel="agent-skills"; type="application/json"

# Prevent your pages.dev deployments showing in search results
https://:vreeman.pages.dev/*
    X-Robots-Tag: noindex

# EntityMap: served as application/json / text/html by default; just add caching
/entitymap.json
    Cache-Control: public, max-age=3600
/entitymap.html
    Cache-Control: public, max-age=3600

# ARDS capability catalog — needs the right Content-Type + CORS so agents can fetch cross-origin
/.well-known/ai-catalog.json
    Content-Type: application/ai-catalog+json
    Access-Control-Allow-Origin: *
    Cache-Control: public, max-age=3600
/.well-known/did.json
    Content-Type: application/did+json
    Access-Control-Allow-Origin: *
    Cache-Control: public, max-age=3600

# OKF bundle — serve the .md concept docs as text/markdown so agents read them inline; allow
# cross-origin fetch. Scoped to *.md so the human landing index.html keeps its text/html type.
/okf/*.md
    Content-Type: text/markdown; charset=utf-8
    Access-Control-Allow-Origin: *

# OKF bundle download (advertised as an ARD catalog entry). Custom media type matches ai-catalog.json.
/okf.tar.gz
    Content-Type: application/okf-bundle+gzip
    Access-Control-Allow-Origin: *
    Cache-Control: public, max-age=3600

# Meditations corpus — the MCP server's search index, and a machine-readable
# edition of Books 1–12. Open CORS so browser agents can fetch it too. Unlike
# entitymap.json above, the Content-Type is stated rather than left to the default:
# this is the one file fetched cross-origin by programs, so the contract is explicit.
/meditations/entries.json
    Content-Type: application/json
    Access-Control-Allow-Origin: *
    Cache-Control: public, max-age=3600

# Agent Skills discovery index (RFC: cloudflare/agent-skills-discovery-rfc v0.2.0), advertised by the
# rel="agent-skills" Link above. Both Content-Types are a MUST in the RFC, so neither is left to what
# Pages would infer: an index that is not application/json, or a SKILL.md that arrives as text/html,
# is a skill a conformant client refuses. CORS so browser-based agents can reach it too.
# Deliberately no Cache-Control on SKILL.md: each index entry carries a SHA-256 of the file, and a
# SKILL.md outliving the index that describes it is a digest mismatch, which clients MUST treat as
# tampering. The index's own hour matches the rest of the machine-readable surfaces here.
/.well-known/agent-skills/index.json
    Content-Type: application/json
    Access-Control-Allow-Origin: *
    Cache-Control: public, max-age=3600
/.well-known/agent-skills/*/SKILL.md
    Content-Type: text/markdown; charset=utf-8
    Access-Control-Allow-Origin: *
